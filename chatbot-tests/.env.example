# ── AI Model Configuration (Follow-Up Generator & Judge) ─────────────────────
# Important Notice - For best practice Use "SECRETS" for the token and Keys
# false: use AWS_* keys from this .env file
# true: fetch a JSON secret from AWS Secrets Manager and use its AWS_* values
USE_AWS_SECRETS_MANAGER=false
AWS_SECRET_NAME=
AWS_SECRETS_MANAGER_REGION=
# Optional bootstrap profile used only to read AWS_SECRET_NAME.
AWS_SECRETS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
BEDROCK_JUDGE_REGION=
BEDROCK_JUDGE_MODEL_ID=
FOLLOW_UP_AI_MODEL=


# ── Argos Application ─────────────────────────────────────────────────────────
ARGOS_BASE_URL=https://www.argos.co.uk/
HEADLESS=false
BROWSER_CHANNEL=chrome
# Launch ordinary installed Chrome and attach through CDP. This avoids the
# Playwright-launched browser fingerprint rejected by Argos/Akamai.
USE_CDP_CHROME=true
CHROME_EXECUTABLE=
CHROME_REMOTE_DEBUGGING_PORT=9223
# Reuse cookies/site state in a dedicated Chrome profile per pytest worker.
USE_PERSISTENT_CONTEXT=true
PLAYWRIGHT_PROFILE_DIR=.playwright-profiles

# ── Scenario Execution Tuning ─────────────────────────────────────────────────
LLM_TIMEOUT_S=60
TREVOR_RESPONSE_TIMEOUT_S=45
SCENARIO_TIMEOUT_S=420
TEST_WORKERS=1
PYTEST_WALL_CLOCK_S=14400
# One worker reuses one profile, so no additional startup stagger is needed.
BROWSER_START_STAGGER_S=0
# Retry an Akamai denial once after a cooldown; do not hammer the blocked endpoint.
ARGOS_NAVIGATION_RETRIES=1
ARGOS_BLOCK_BACKOFF_S=20
# Maximum wait for each Playwright shutdown step before the worker continues.
PLAYWRIGHT_TEARDOWN_TIMEOUT_S=15
